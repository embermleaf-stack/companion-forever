{
  "expo": {
    "name": "Companion Forever",
    "slug": "companion-forever",
    "scheme": "companionforever",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "backgroundColor": "#14171F",
    "ios": {
      "bundleIdentifier": "io.github.embermleaf.companionforever"
    },
    "android": {
      "allowBackup": false,
      "package": "io.github.embermleaf.companionforever",
      "backgroundColor": "#14171F",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#161C22"
      }
    },
    "plugins": [
      "expo-sharing",
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#14171F"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
